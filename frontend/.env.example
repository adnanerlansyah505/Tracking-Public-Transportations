# Public Runtime Config
NUXT_PUBLIC_APP_NAME="AngkotTracker"
NUXT_PUBLIC_APP_URL="http://localhost:4000"
NUXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# Mapbox Access Token
# Get your free public token at https://account.mapbox.com/access-tokens/
# Use a public `pk.` token only, restricted to your own URLs — a browser bundle
# cannot keep a token secret, so secret `sk.` tokens must never be used here.
NUXT_PUBLIC_MAPBOX_TOKEN=""
